# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MySQL Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ceylon_trails
DB_USER=root
DB_PASSWORD=

# JWT
JWT_SECRET=replace_this_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# Admin bootstrap (used by db:seed to create the first admin account)
ADMIN_NAME=Site Admin
ADMIN_EMAIL=admin@ceylontrails.com
ADMIN_PASSWORD=Admin@12345
